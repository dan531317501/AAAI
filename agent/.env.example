# ===== LLM 配置（任意 OpenAI 兼容端点）=====
# 复制本文件为 .env 并填入真实值

LLM_API_KEY=sk-cbf55f613bcb4ec8ad04d58a75730a03

# API 地址（OpenAI 兼容格式，以 /v1 结尾；DeepSeek/Qwen/Moonshot 等均可）
LLM_API_URL=https://api.openai.com/v1

# 模型名
LLM_MODEL=gpt-4o-mini

# ReAct 循环最大步数（达到后强制输出最终答案）
MAX_STEPS=5

# 流式输出：大于 0 时逐字符打字机延时（秒）；0 = 按 token 即时输出
STREAM_CHAR_DELAY=0
